\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Phase 1 optimizer experiment under full participation. The five conditions are evaluated over three paired seeds; bars show final test mean and minimum client accuracy and macro-F1, the hatched bars denote minimum-client metrics, and error bars are 95\% descriptive t intervals across seeds.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:optimizer-quality}{{4}{9}{Phase 1 optimizer experiment under full participation. The five conditions are evaluated over three paired seeds; bars show final test mean and minimum client accuracy and macro-F1, the hatched bars denote minimum-client metrics, and error bars are 95\% descriptive t intervals across seeds}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Internal hypervolume trajectories for the three multiobjective optimizers in the full-participation experiment. Each panel uses the optimizer's own objective space: two aggregate validation objectives for NSGA-II and eight per-client validation objectives for NSGA-III and MOEA/D. Lines and shaded regions show means and 95\% descriptive t intervals across the three seeds; values are compared only within a panel.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:optimizer-hypervolume}{{5}{9}{Internal hypervolume trajectories for the three multiobjective optimizers in the full-participation experiment. Each panel uses the optimizer's own objective space: two aggregate validation objectives for NSGA-II and eight per-client validation objectives for NSGA-III and MOEA/D. Lines and shaded regions show means and 95\% descriptive t intervals across the three seeds; values are compared only within a panel}{figure.5}{}}
